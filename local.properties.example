# Copy to local.properties (which is git-ignored) and fill in.
#
# sdk.dir is written for you by Android Studio on first open. If you build from the
# command line instead, point it at your SDK.
sdk.dir=/Users/YOU/Library/Android/sdk

# Firebase Console -> Authentication -> Sign-in method -> Google
#   -> Web SDK configuration -> Web client ID
# Leave blank to build without Google Sign-In; email/password and guest still work.
WEB_CLIENT_ID=

# Supabase -> Project Settings -> API. Image bytes live in a Supabase Storage bucket
# because Firebase Storage needs the Blaze plan. The anon key is public by design.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Bucket name created by supabase/storage-policies.sql. Only change if you renamed it there.
SUPABASE_BUCKET=roll
